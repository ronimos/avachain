# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables and secrets
.env
*.env

# Logs and databases
*.log
*.db
nohup.out

# Local scripts and data
data/eval
temp/
scripts/
*.ipynb

# Backups and temporary files
*.bak
*.tmp
*.zip
*GH001*

# Source input data — large files excluded, small boundary/config files tracked
data/dem/
data/surveys/
data/weather/*.csv
# data/boundaries/ and data/weather/refill.* ARE tracked (version-controlled inputs)

# Pipeline outputs (all derived/regeneratable)
outputs/
results/

# Snowpack runtime data — per-slope input/output dirs (large, derived)
snowpack/*/output/
snowpack/*/input/
snowpack/*/windninja/
snowpack/*/temp/

# Slope-specific large assets
slopes/*/windninja/

# Claude Code internal files
claude-code-pilot/

# Raw SNOWPACK file types (never commit these regardless of location)
*.smet
*.sno
*.pro
*.zarr
# Exception: the weather refill template is a small, version-controlled input
!data/weather/refill.smet
!data/weather/refill.sno

# Misc large binaries
*.tif
*.tiff
*.csv
config.json
models/
checkpoints/
windninja/
windninja
src/avachain/windninja/
Miniforge3-Linux-x86_64.sh
ffmpeg*/

# ISSW reinit comparison runs (large SNOWPACK output, not source-controlled)
snowpack/*/comparison/