// Release-area model flow (Ron, 2026-11-10; updated 2026-11-13). Render:
//   dot -Tpng -Gdpi=150 docs/figures/release_model_flow.dot -o docs/figures/release_model_flow.png
digraph release_model {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.35, newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#555555", fontname="Helvetica", fontsize=10];
  edge  [color="#555555", arrowsize=0.7, fontname="Helvetica", fontsize=9];

  subgraph cluster_in {
    label="Inputs"; style="rounded,filled"; fillcolor="#eef3f8"; color="#9fb3c8";
    pro  [label="SNOWPACK profiles per cluster\n(snapshot time)"];
    dem  [label="1 m DEM, cluster map,\nstart-zone KML"];
    {rank=same; pro; dem;}
  }

  subgraph cluster_feat {
    label="Per-cluster features (snowpack_features)"; style="rounded,filled"; fillcolor="#f4f4f4"; color="#bbbbbb";
    feat [label="WL / slab split: basal FC/DH layer\n(threshold-sum WL: option, off)\nslab ρ, h, σt (J&J 1990 x facet knockdown,\nprimary grain class), K_Ic;  WL τp, r_c, Sk38"];
    mel  [label="Meloche features\nτg, Λ, θ (plane fit), Π₁, A_ca"];
    feat -> mel;
  }
  pro -> feat; dem -> mel;

  subgraph cluster_trig {
    label="Trigger selection (generate_scenarios)"; style="rounded,filled"; fillcolor="#fff6e5"; color="#e0b660";
    t1 [label="1  τg ≥ 40 Pa, ψ ≥ Stauchwall + 2°, Sk38 < 1"];
    t2 [label="2  0.3 m ≤ h ≤ 2.0 m"];
    t2b[label="2b  S_t ≥ 1 with σt capped by toughness\nK_Ic / (1.122 √(π h/2))   [trigger only]"];
    t3 [label="3  elevation ≥ P50   (relative)"];
    t4 [label="4  Π₁ ≥ median   (relative)"];
    rk [label="rank: lowest Sk38, ties by r_c; top N"];
    t1 -> t2 -> t2b -> t3 -> t4 -> rk;
  }
  mel -> t1;

  subgraph cluster_bfs {
    label="Crack propagation BFS, per trigger (propagate_crack)\nlinks: 8 nearest cluster centroids"; style="rounded,filled"; fillcolor="#eaf6ec"; color="#7fbf8a";
    cand [label="candidate neighbour of an admitted cluster", fillcolor="#ffffff"];
    gates [shape=box, style="filled", fillcolor="#ffffff", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1">
      <TR><TD ALIGN="LEFT"><B>Arrest gates, in order</B></TD></TR>
      <TR><TD ALIGN="LEFT">start-zone mask</TD></TR>
      <TR><TD ALIGN="LEFT">distance caps (if USE_DISTANCE_CAPS)</TD></TR>
      <TR><TD ALIGN="LEFT">Stauchwall: mean slope &lt; 29° (not upslope)</TD></TR>
      <TR><TD ALIGN="LEFT">τg &lt; TAU_G_ABS_FLOOR;  τg/τp &lt; TAU_RATIO_FLOOR</TD></TR>
      <TR><TD ALIGN="LEFT">thin slab (h &lt; 0.3 m);  low Λ</TD></TR>
      <TR><TD ALIGN="LEFT"><B>slab tensile failure  S_t &lt; 1</B></TD></TR>
      <TR><TD ALIGN="LEFT">Meloche Eq. 20 directional arrest (A_ca &lt; step)</TD></TR>
      </TABLE>>];
    adm  [label="admitted: joins the region", fillcolor="#d7f0dc"];
    arr  [label="arrested", fillcolor="#f6dcdc"];
    crk  [label="slab crack starts\nupslope step → crown (runs cross-slope)\ncross-slope step → flank (runs along fall line)", fillcolor="#fde9d9"];
    cand -> gates;
    gates -> adm [label=" passes all"];
    gates -> arr [label=" any gate"];
    arr -> crk [label=" only S_t < 1", style=dashed];
    adm -> cand [label=" next ring", style=dotted];
  }
  rk -> cand [label=" each trigger"];

  subgraph cluster_post {
    label="After the BFS"; style="rounded,filled"; fillcolor="#f3ecf8"; color="#b39bcc";
    lines [label="slab-crack lines (USE_SLAB_CRACK_LINES)\none best-aligned neighbour per step,\nwhile the slab is loaded (θ > φ = 27°)"];
    sever [label="remove the area the lines sever from the trigger,\nunless that piece slides: mean slope > atan μ = 31.8°\n(USE_SEVERED_SLIDE, μ = 0.62);  line clusters stay"];
    poly  [label="polygon: largest part, holes filled,\nclipped to start zone and Stauchwall, ≥ 200 m²"];
    lines -> sever -> poly;
  }
  crk -> lines;
  adm -> lines [label=" region", style=dashed];

  out [label="scenario set: trigger x size factor x depth percentile\ndepth raster (slab h), polygon density, weights → com1DFA", fillcolor="#eef3f8"];
  poly -> out;
}
